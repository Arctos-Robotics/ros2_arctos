<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="arctos_ros2_control" params="name initial_positions_file">
    <xacro:property name="initial_positions"
      value="${load_yaml(initial_positions_file)['initial_positions']}" />

    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>arctos_interface/ArctosInterface</plugin>
      </hardware>
      <joint name="X_joint">
        <command_interface name="position">
          <!-- <param name="min">{-2*pi}</param>
          <param name="max">{2*pi}</param> -->
        </command_interface>
        <command_interface name="velocity">
          <!-- <param name="min">-3.15</param>
          <param name="max">3.15</param> -->
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['X_joint']}</param>
        </state_interface>
        <state_interface name="velocity" />
      </joint>
      <joint name="Y_joint">
        <command_interface name="position">
          <!-- <param name="min">{-2*pi}</param>
          <param name="max">{2*pi}</param> -->
        </command_interface>
        <command_interface name="velocity">
          <!-- <param name="min">-3.15</param>
          <param name="max">3.15</param> -->
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['Y_joint']}</param>
        </state_interface>
        <state_interface name="velocity" />
      </joint>
      <joint name="Z_joint">
        <command_interface name="position">
          <!-- <param name="min">{-pi}</param>
          <param name="max">{pi}</param> -->
        </command_interface>
        <command_interface name="velocity">
          <!-- <param name="min">-3.15</param>
          <param name="max">3.15</param> -->
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['Z_joint']}</param>
        </state_interface>
        <state_interface name="velocity" />
      </joint>
      <joint name="A_joint">
        <command_interface name="position">
          <!-- <param name="min">{-2*pi}</param>
          <param name="max">{2*pi}</param> -->
        </command_interface>
        <command_interface name="velocity">
          <!-- <param name="min">-3.2</param>
          <param name="max">3.2</param> -->
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['A_joint']}</param>
        </state_interface>
        <state_interface name="velocity" />
      </joint>
      <joint name="B_joint">
        <command_interface name="position">
          <!-- <param name="min">{-2*pi}</param>
          <param name="max">{2*pi}</param> -->
        </command_interface>
        <command_interface name="velocity">
          <!-- <param name="min">-3.2</param>
          <param name="max">3.2</param> -->
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['B_joint']}</param>
        </state_interface>
        <state_interface name="velocity" />
      </joint>
      <joint name="C_joint">
        <command_interface name="position">
          <!-- <param name="min">{-2*pi}</param>
          <param name="max">{2*pi}</param> -->
        </command_interface>
        <command_interface name="velocity">
          <!-- <param name="min">-3.2</param>
          <param name="max">3.2</param> -->
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['C_joint']}</param>
        </state_interface>
        <state_interface name="velocity" />
      </joint>
      <joint name="Left_jaw_joint">
        <command_interface name="position" />
        <command_interface name="velocity" />
        <state_interface name="position">
          <param name="initial_value">${initial_positions['Left_jaw_joint']}</param>
        </state_interface>
        <state_interface name="velocity" />
      </joint>
      <joint name="Right_jaw_joint">
        <command_interface name="position" />
        <command_interface name="velocity" />
        <state_interface name="position">
          <param name="initial_value">${initial_positions['Right_jaw_joint']}</param>
        </state_interface>
        <state_interface name="velocity" />
      </joint>

    </ros2_control>
  </xacro:macro>
</robot>